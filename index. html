<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Para Camí ❤️</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
  :root{
    --rose-1:#ff6b96;
    --rose-2:#e01e5a;
    --rose-3:#9d0a45;
    --rose-4:#4e0226;
    --pink-soft:#ffd1e0;
    --gold:#ffcf6b;
    --cream:#fff8f2;
    --ink:#591a33;
  }

  *{box-sizing:border-box;margin:0;padding:0;}
  html{background:#4e0226;}
  body{
    font-family:'Cormorant Garamond',Georgia,serif;
    color:#fff;
    min-height:100vh;
    overflow-x:hidden;
    -webkit-tap-highlight-color:transparent;
  }
  body.locked{overflow:hidden;height:100vh;}

  /* ---------- Fondo ---------- */
  .bg{
    position:fixed; inset:0; z-index:-2;
    background:
      radial-gradient(circle at 12% 6%, rgba(255,195,220,.55), transparent 42%),
      radial-gradient(circle at 88% 16%, rgba(255,135,175,.42), transparent 46%),
      radial-gradient(circle at 50% 106%, rgba(255,105,155,.45), transparent 55%),
      linear-gradient(160deg,#ff6b96 0%, #e01e5a 30%, #9d0a45 66%, #4e0226 100%);
  }

  /* ---------- Pétalos ---------- */
  .petals{position:fixed;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .petal{
    position:absolute; top:-40px;
    width:13px; height:16px;
    background:radial-gradient(circle at 32% 28%, #ffc0d6, #ff4d88 55%, #c9184a);
    border-radius:72% 0 72% 0;
    opacity:0;
    animation:petalFall linear forwards;
    filter:drop-shadow(0 2px 4px rgba(80,0,30,.25));
  }
  @keyframes petalFall{
    0%{transform:translate3d(0,-8vh,0) rotate(0deg);opacity:0;}
    12%{opacity:.9;}
    88%{opacity:.65;}
    100%{transform:translate3d(var(--dx,0px), 112vh, 0) rotate(760deg);opacity:0;}
  }

  /* ---------- Portada: sobre ---------- */
  .intro{
    position:fixed; inset:0; z-index:10;
    display:flex; align-items:center; justify-content:center;
    padding:26px;
    transition:opacity .9s ease, transform .9s ease;
  }
  .intro.hide{opacity:0;transform:scale(1.08);pointer-events:none;}

  .intro-inner{
    text-align:center;
    display:flex; flex-direction:column; align-items:center;
    animation:introIn 1.3s ease both;
  }
  @keyframes introIn{
    from{opacity:0;transform:translateY(26px);}
    to{opacity:1;transform:none;}
  }

  .intro-name{
    font-family:'Great Vibes',cursive;
    font-size:clamp(3.2rem,13vw,4.6rem);
    color:#fff;
    line-height:1;
    text-shadow:0 0 34px rgba(255,190,215,.9), 0 4px 24px rgba(80,0,30,.45);
  }
  .intro-subname{
    margin-top:6px;
    font-family:'Great Vibes',cursive;
    font-size:clamp(1.5rem,6vw,2rem);
    color:#ffe4ee;
    line-height:1.1;
    text-shadow:0 0 22px rgba(255,190,215,.7), 0 3px 16px rgba(80,0,30,.4);
  }
  .intro-text{
    margin-top:20px;
    font-size:clamp(1.02rem,3.9vw,1.18rem);
    font-style:italic;
    line-height:1.65;
    color:#fff0f5;
    max-width:340px;
    text-shadow:0 2px 14px rgba(80,0,30,.35);
  }

  .envelope-wrap{
    margin:34px 0 26px;
    animation:floatEnv 4.5s ease-in-out infinite;
  }
  @keyframes floatEnv{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-11px);}
  }

  .envelope{
    --w:min(320px, 78vw);
    width:var(--w);
    height:calc(var(--w) * .64);
    position:relative;
    perspective:1200px;
    cursor:pointer;
    filter:drop-shadow(0 26px 42px rgba(60,0,25,.5));
    transition:transform .35s ease;
  }
  .envelope:hover{transform:scale(1.03);}

  .env-body{
    position:relative;
    width:100%; height:100%;
    transform-style:preserve-3d;
    border-radius:12px;
    background:linear-gradient(180deg,#ff7fa8,#d81a56);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);
  }

  .env-letter{
    position:absolute; left:6%; right:6%; top:8%; height:84%;
    background:linear-gradient(180deg,#fffaf6,#ffeaf1);
    border-radius:5px;
    z-index:2;
    display:flex; align-items:center; justify-content:center;
    color:#e01e5a; font-size:calc(var(--w)*.08);
    box-shadow:0 3px 12px rgba(90,0,35,.18);
    transition:transform .8s cubic-bezier(.3,1.3,.5,1) .45s;
  }

  .env-front-left,
  .env-front-right,
  .env-front-bottom,
  .env-flap{
    position:absolute; inset:0;
    border-radius:12px;
  }
  .env-front-left{
    clip-path:polygon(0 0, 50% 50%, 0 100%);
    background:linear-gradient(135deg,#ff8fb4,#ef2f6c);
    z-index:3;
  }
  .env-front-right{
    clip-path:polygon(100% 0, 50% 50%, 100% 100%);
    background:linear-gradient(225deg,#ff8fb4,#e01e5a);
    z-index:3;
  }
  .env-front-bottom{
    clip-path:polygon(0 100%, 50% 50%, 100% 100%);
    background:linear-gradient(0deg,#d81a56,#ff6f9c);
    z-index:4;
    border-radius:0 0 12px 12px;
  }
  .env-flap{
    height:58%;
    background:linear-gradient(180deg,#ffa7c3,#ff5f8d);
    clip-path:polygon(0 0, 100% 0, 50% 100%);
    transform-origin:top center;
    transition:transform .95s cubic-bezier(.55,-.15,.4,1.2), background .6s;
    z-index:6;
    backface-visibility:hidden;
  }
  .envelope.open .env-flap{transform:rotateX(180deg);background:#e01e5a;}
  .envelope.open .env-letter{transform:translateY(-16%);}

  .env-seal{
    position:absolute; left:50%; top:54%;
    transform:translate(-50%,-50%);
    width:19%; aspect-ratio:1; border-radius:50%;
    background:radial-gradient(circle at 34% 28%, #ffe9b0, #ffc44d 48%, #dd8b00);
    display:grid; place-items:center;
    font-family:'Great Vibes',cursive;
    color:#8c0740;
    font-size:calc(var(--w) * .095);
    line-height:1;
    z-index:7;
    box-shadow:0 5px 16px rgba(80,0,30,.45), inset 0 -2px 7px rgba(150,80,0,.4);
    transition:opacity .45s ease, transform .45s ease;
  }
  .envelope.open .env-seal{opacity:0;transform:translate(-50%,-50%) scale(.4);}

  .intro-hint{
    font-size:.85rem;
    letter-spacing:3.5px;
    text-transform:uppercase;
    color:#ffe4ee;
    animation:hintPulse 2.2s ease-in-out infinite;
  }
  .intro-hint span{color:#ffcf6b;}
  @keyframes hintPulse{
    0%,100%{opacity:.55;}
    50%{opacity:1;}
  }

  /* ---------- Carta ---------- */
  .letter-scene{
    display:none;
    position:relative; z-index:2;
    max-width:620px;
    margin:0 auto;
    padding:44px 14px 80px;
  }
  .letter-scene.show{
    display:block;
    animation:sceneIn 1.1s ease both;
  }
  @keyframes sceneIn{
    from{opacity:0;transform:translateY(30px);}
    to{opacity:1;transform:none;}
  }

  .paper{
    position:relative;
    background:
      radial-gradient(circle at 18% 8%, rgba(255,205,225,.55), transparent 52%),
      linear-gradient(180deg,#fffcf9 0%, #fff1f5 100%);
    border-radius:18px;
    padding:58px 26px 50px;
    color:var(--ink);
    box-shadow:
      0 34px 80px -28px rgba(60,0,25,.6),
      0 0 0 1px rgba(255,255,255,.7) inset,
      0 0 90px rgba(255,150,190,.28) inset;
  }

  .tag{
    position:absolute; top:-16px; left:50%; transform:translateX(-50%);
    background:linear-gradient(135deg,#ff5f8d,#d81a56);
    color:#fff;
    font-family:'Great Vibes',cursive;
    font-size:1.15rem;
    padding:7px 26px;
    border-radius:999px;
    letter-spacing:1px;
    box-shadow:0 10px 24px -8px rgba(180,0,60,.7);
    white-space:nowrap;
  }

  .paper h1{
    font-family:'Great Vibes',cursive;
    font-weight:400;
    font-size:clamp(2rem,8.2vw,2.85rem);
    color:#d61a5c;
    line-height:1.18;
    text-align:center;
    text-shadow:0 2px 18px rgba(255,150,190,.5);
  }
  .subtitle{
    text-align:center;
    font-style:italic;
    color:#a3234f;
    font-size:clamp(.98rem,3.6vw,1.08rem);
    margin-top:10px;
  }

  .divider{
    display:flex; align-items:center; justify-content:center; gap:12px;
    margin:30px 0 36px;
    color:#e01e5a;
  }
  .divider::before, .divider::after{
    content:''; height:1px; flex:1; max-width:110px;
    background:linear-gradient(90deg,transparent,#f3a7c0,transparent);
  }
  .divider span{font-size:1rem;}

  .poem p{
    font-size:clamp(1rem,3.7vw,1.1rem);
    line-height:1.95;
    text-align:left;
    margin-bottom:1.55em;
    color:#5c1b34;
    opacity:0;
    transform:translateY(22px);
    transition:opacity .95s ease, transform .95s ease;
  }
  .poem p.visible{opacity:1;transform:none;}

  .poem p:last-child{
    margin-bottom:0;
    font-style:italic;
    color:#a3234f;
    text-align:center;
    padding-top:.6em;
  }

  .name{
    color:#d61a5c;
    font-style:italic;
    font-weight:500;
  }

  .sign{
    margin-top:44px;
    padding-top:30px;
    border-top:1px solid rgba(224,30,90,.18);
    text-align:center;
  }
  .sign-heart{
    font-size:1.6rem;
    color:#e01e5a;
    display:inline-block;
    animation:pulse 1.9s ease-in-out infinite;
    filter:drop-shadow(0 0 12px rgba(224,30,90,.45));
  }
  @keyframes pulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.18);}
  }
  .sign-text{
    margin-top:10px;
    font-style:italic;
    color:#a3234f;
    font-size:1.02rem;
  }
  .sign-name{
    font-family:'Great Vibes',cursive;
    font-size:2rem;
    color:#d61a5c;
    margin-top:4px;
    line-height:1.2;
  }

  @media (max-width:520px){
    .paper{padding:52px 19px 44px;border-radius:14px;}
    .letter-scene{padding:36px 10px 70px;}
  }
</style>
</head>
<body class="locked">

<div class="bg"></div>
<div class="petals" id="petals"></div>

<!-- ================= PORTADA: SOBRE ================= -->
<section class="intro" id="intro">
  <div class="intro-inner">

    <p class="intro-name">Camí</p>
    <p class="intro-subname">mi niña, mi corazón ❤️</p>

    <p class="intro-text">
      Hay cosas que no quiero dejar pasar sin decírtelas.<br>
      Así que las escribí.
    </p>

    <div class="envelope-wrap">
      <div class="envelope" id="envelope" role="button" tabindex="0" aria-label="Abrir la carta">
        <div class="env-body">
          <div class="env-letter">❤️</div>
          <div class="env-front-left"></div>
          <div class="env-front-right"></div>
          <div class="env-front-bottom"></div>
          <div class="env-flap"></div>
          <div class="env-seal">C</div>
        </div>
      </div>
    </div>

    <p class="intro-hint">Toca el sobre <span>♥</span></p>

  </div>
</section>

<!-- ================= LA CARTA ================= -->
<main class="letter-scene" id="letterScene">
  <article class="paper">
    <div class="tag">Para Camí ❤️</div>

    <h1>A Camí, mi corazón</h1>
    <p class="subtitle">en la inmensidad de mis horas</p>

    <div class="divider"><span>❦</span></div>

    <div class="poem">
      <p>Aunque mis días se llenen de fatigas y mil afanes reclamen el tributo de mi desvelo,<br>
      hay un amor que vence toda sombra y no se rinde al vértigo de las horas que pasan:<br>
      tu presencia, <span class="name">Camí, mi corazón</span>, es la estrella más dulce, más alta y más viva de mi firmamento.</p>

      <p>Te llevo conmigo sin siquiera notarlo, en el santuario más tierno y luminoso de mi alma;<br>
      cuando mis ojos buscan sin quererlo tu nombre entre las luces de una pequeña esfera,<br>
      como quien aguarda, rendido y sereno, hallar el astro que guía y enamora su camino.</p>

      <p>No quiero que mi amor se vuelva exigencia ni que mi anhelo pese como carga en tu jornada;<br>
      te he elegido, mi corazón, con tus tiempos lentos, tus deberes, tus ausencias y tus tardes,<br>
      porque amar de verdad es saber dar espacio y honrar, con ternura infinita, tu libertad.</p>

      <p>No vengo a reclamar el trono de tus horas, sino a merecer un refugio tibio y fiel en ellas;<br>
      no quisiera ser quien turbe tu andar pausado, sino ese puerto luminoso adonde vuelvas<br>
      con la alegría intacta en la mirada de tu voz, sabiendo que te espero sin prisa y con todo el ser.</p>

      <p>Ve, pues, a cumplir cuanto la vida demande a tu noble camino, a tus pasos y a tus sueños,<br>
      que yo prosigo también entre mis días llevándote en la sangre, en el pecho y en la memoria;<br>
      no hay silencio ni pausa en este mundo que apague el fuego tierno y constante que me guía<br>
      hacia la paz bendita y resplandeciente de tu nombre.</p>

      <p>Y cuando llegue la noche y nos devuelva nuestras palabras, no hallarás un reproche en mi voz,<br>
      sino el mismo amor, hondo, fiel y tibio, aguardándote intacto en la quietud de las horas,<br>
      como si el tiempo mismo hubiese hecho una pausa larga solo para bendecir nuestro encuentro.</p>

      <p>Jamás le pediré al destino que apresure el paso ni que detenga el giro soberano de tu mundo<br>
      para abrirme un sendero a fuerza de prisa; mi dicha más profunda y más sagrada<br>
      es caminar despacio a tu lado, mi corazón, mientras construyes, libre y entera, tu universo.</p>

      <p>Y si algo quiero que jamás olvides, <span class="name">Camí, mi corazón</span>, es esta promesa sin apuros:<br>
      no necesito tenerte a cada instante en mi horizonte para respirar el milagro de tu existencia;<br>
      vas conmigo, eternamente amada, en cada latido que me da la vida y en cada paso que doy.</p>
    </div>

    <footer class="sign">
      <div class="sign-heart">❤️</div>
      <div class="sign-text">Con todo mi corazón,</div>
      <div class="sign-name">José Manuel</div>
    </footer>
  </article>
</main>

<script>
  /* ---------- Pétalos ---------- */
  const petalsLayer = document.getElementById('petals');
  function spawnPetal(){
    const p = document.createElement('div');
    p.className = 'petal';
    const size = 9 + Math.random() * 9;
    p.style.width = size + 'px';
    p.style.height = (size * 1.25) + 'px';
    p.style.left = Math.random() * 100 + 'vw';
    p.style.setProperty('--dx', (Math.random() * 160 - 80) + 'px');
    const dur = 9 + Math.random() * 9;
    p.style.animationDuration = dur + 's';
    p.style.opacity = 0.5 + Math.random() * 0.5;
    petalsLayer.appendChild(p);
    setTimeout(() => p.remove(), dur * 1000 + 800);
  }
  for (let i = 0; i < 7; i++) setTimeout(spawnPetal, i * 420);
  setInterval(spawnPetal, 1100);

  /* ---------- Apertura del sobre ---------- */
  const intro   = document.getElementById('intro');
  const envelope= document.getElementById('envelope');
  const envBody = document.querySelector('.env-body');
  const scene   = document.getElementById('letterScene');
  let opened = false;

  function openLetter(){
    if (opened) return;
    opened = true;

    envelope.classList.add('open');
    envBody.style.animationPlayState = 'paused';

    setTimeout(() => {
      intro.classList.add('hide');
      scene.classList.add('show');
      document.body.classList.remove('locked');
      window.scrollTo(0, 0);

      setTimeout(() => { intro.style.display = 'none'; }, 950);
      setTimeout(revealInit, 300);
    }, 1150);
  }

  envelope.addEventListener('click', openLetter);
  envelope.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLetter(); }
  });

  /* ---------- Aparición del poema ---------- */
  function revealInit(){
    const paras = document.querySelectorAll('.poem p');
    if (!('IntersectionObserver' in window)) {
      paras.forEach(p => p.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

    paras.forEach(p => io.observe(p));
  }
</script>
</body>
</html>
